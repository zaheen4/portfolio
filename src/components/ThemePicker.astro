---
const themes = [
    { id: "warm-dark", name: "Warm Dark", dot: "#d97706", isDark: true },
    { id: "warm-light", name: "Warm Light", dot: "#d97706", isDark: false },
    { id: "dracula", name: "Dracula", dot: "#bd93f9", isDark: true },
    { id: "nord", name: "Nord", dot: "#88c0d0", isDark: true },
    { id: "monokai", name: "Monokai", dot: "#a6e22e", isDark: true },
    { id: "tokyo-night", name: "Tokyo Night", dot: "#7aa2f7", isDark: true },
    {
        id: "catppuccin-mocha",
        name: "Catppuccin Mocha",
        dot: "#cba6f7",
        isDark: true,
    },
    { id: "one-dark", name: "One Dark", dot: "#61afef", isDark: true },
    { id: "github-light", name: "GitHub Light", dot: "#0969da", isDark: false },
    {
        id: "solarized-light",
        name: "Solarized Light",
        dot: "#268bd2",
        isDark: false,
    },
    {
        id: "catppuccin-latte",
        name: "Catppuccin Latte",
        dot: "#7287fd",
        isDark: false,
    },
];

const darkThemes = themes.filter((theme) => theme.isDark);
const lightThemes = themes.filter((theme) => !theme.isDark);
---

<div class="theme-picker relative" data-theme-picker>
    <button
        class="theme-toggle p-2 rounded-lg transition-colors duration-200 hover:bg-card"
        style="color: var(--text-secondary);"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label="Switch theme"
        data-mode="dark"
    >
        <svg
            class="icon-sun"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
            class="icon-moon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
    </button>

    <div
        class="theme-dropdown absolute right-0 top-full mt-2 z-50 w-72 rounded-xl border shadow-2xl overflow-hidden"
        style="background-color: var(--bg-card); border-color: var(--bg-border);"
    >
        <div class="p-4 border-b" style="border-color: var(--bg-border);">
            <h3 class="font-semibold text-sm" style="color: var(--text-primary);">
                Choose Theme
            </h3>
        </div>

        <div class="theme-scroll p-3 pb-6" role="listbox" aria-label="Choose a theme">
            <div class="mb-2">
                <button
                    class="w-full flex items-center gap-3 px-3 py-2 rounded-lg theme-option"
                    role="option"
                    aria-selected="false"
                    tabindex="-1"
                    data-theme-id="system"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="flex-shrink: 0;"
                    >
                        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                        <path d="M8 21h8"></path>
                        <path d="M12 17v4"></path>
                    </svg>
                    <span class="text-sm font-medium" style="color: var(--text-primary);">
                        System Default
                    </span>
                    <svg
                        class="theme-check ml-auto flex-shrink-0"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--accent)"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                </button>
            </div>

            <p
                class="text-xs font-semibold uppercase tracking-wider mb-2 px-3 flex items-center gap-1.5"
                style="color: var(--text-muted);"
            >
                <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                </svg>
                Dark
            </p>
            <div class="space-y-1 mb-4">
                {
                    darkThemes.map((theme) => (
                        <button
                            class="w-full flex items-center gap-3 px-3 py-2 rounded-lg theme-option"
                            role="option"
                            aria-selected="false"
                            tabindex="-1"
                            data-theme-id={theme.id}
                            data-dark="true"
                        >
                            <span
                                class="w-5 h-5 rounded-full flex-shrink-0 dot"
                                style={`background-color: ${theme.dot};`}
                            />
                            <span
                                class="text-sm font-medium"
                                style="color: var(--text-primary);"
                            >
                                {theme.name}
                            </span>
                            <svg
                                class="theme-check ml-auto flex-shrink-0"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="var(--accent)"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                        </button>
                    ))
                }
            </div>

            <p
                class="text-xs font-semibold uppercase tracking-wider mb-2 px-3 flex items-center gap-1.5"
                style="color: var(--text-muted);"
            >
                <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                </svg>
                Light
            </p>
            <div class="space-y-1">
                {
                    lightThemes.map((theme) => (
                        <button
                            class="w-full flex items-center gap-3 px-3 py-2 rounded-lg theme-option"
                            role="option"
                            aria-selected="false"
                            tabindex="-1"
                            data-theme-id={theme.id}
                            data-dark="false"
                        >
                            <span
                                class="w-5 h-5 rounded-full flex-shrink-0 dot"
                                style={`background-color: ${theme.dot};`}
                            />
                            <span
                                class="text-sm font-medium"
                                style="color: var(--text-primary);"
                            >
                                {theme.name}
                            </span>
                            <svg
                                class="theme-check ml-auto flex-shrink-0"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="var(--accent)"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                        </button>
                    ))
                }
            </div>
        </div>
    </div>
</div>

<script>
    const roots = Array.from(document.querySelectorAll("[data-theme-picker]"));

    if (roots.length > 0) {
        const darkIds = new Set(
            Array.from(
                document.querySelectorAll(
                    '[data-theme-picker] [role="option"][data-dark="true"]',
                ),
            ).map((el) => el.getAttribute("data-theme-id")),
        );

        const resolveTheme = (theme) => {
            if (theme === "system") {
                return window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "warm-dark"
                    : "warm-light";
            }
            return theme;
        };

        const readStoredTheme = () => {
            try {
                return localStorage.getItem("theme") || "system";
            } catch {
                return "system";
            }
        };

        let selectedTheme = readStoredTheme();
        let hasInteracted = false;
        let themeTimeout = null;
        let overlayTimeout = null;

        const updateUI = () => {
            const isDark = darkIds.has(resolveTheme(selectedTheme));
            roots.forEach((root) => {
                const toggle = root.querySelector(".theme-toggle");
                if (toggle) toggle.dataset.mode = isDark ? "dark" : "light";
                root.querySelectorAll('[role="option"]').forEach((option) => {
                    const active =
                        option.getAttribute("data-theme-id") === selectedTheme;
                    option.classList.toggle("active", active);
                    option.setAttribute("aria-selected", String(active));
                });
            });
        };

        const instances = roots
            .map((root) => {
                const toggle = root.querySelector(".theme-toggle");
                const dropdown = root.querySelector(".theme-dropdown");
                if (!toggle || !dropdown) return null;

                const options = Array.from(
                    dropdown.querySelectorAll('[role="option"]'),
                );
                let activeIndex = -1;

                const focusOption = (index) => {
                    activeIndex = index;
                    const el = options[index];
                    if (!el) return;
                    el.focus({ preventScroll: true });
                    el.scrollIntoView({ block: "nearest", behavior: "smooth" });
                };

                const isOpen = () => dropdown.classList.contains("open");

                const close = () => {
                    dropdown.classList.remove("open");
                    toggle.setAttribute("aria-expanded", "false");
                    if (hasInteracted) toggle.focus({ preventScroll: true });
                };

                const open = () => {
                    hasInteracted = true;
                    dropdown.classList.add("open");
                    toggle.setAttribute("aria-expanded", "true");
                    let index = options.findIndex(
                        (option) =>
                            option.getAttribute("data-theme-id") ===
                            selectedTheme,
                    );
                    if (index < 0) index = 0;
                    focusOption(index);
                };

                toggle.addEventListener("click", () =>
                    isOpen() ? close() : open(),
                );

                dropdown.addEventListener("keydown", (event) => {
                    const key = event.key;
                    if (key === "Escape") {
                        event.preventDefault();
                        close();
                        return;
                    }
                    if (key === "ArrowDown" || key === "ArrowUp") {
                        event.preventDefault();
                        const direction = key === "ArrowDown" ? 1 : -1;
                        focusOption(
                            (activeIndex + direction + options.length) %
                                options.length,
                        );
                        return;
                    }
                    if (key === "Home") {
                        event.preventDefault();
                        focusOption(0);
                        return;
                    }
                    if (key === "End") {
                        event.preventDefault();
                        focusOption(options.length - 1);
                    }
                });

                options.forEach((option) => {
                    option.addEventListener("click", () =>
                        setTheme(option.getAttribute("data-theme-id")),
                    );
                });

                return { root, isOpen, close };
            })
            .filter(Boolean);

        function setTheme(themeId) {
            clearTimeout(themeTimeout);
            clearTimeout(overlayTimeout);
            window.dispatchEvent(new CustomEvent("theme-transition-start"));
            instances.forEach((instance) => instance.close());
            themeTimeout = setTimeout(() => {
                try {
                    localStorage.setItem("theme", themeId);
                } catch {
                    /* ignore */
                }
                selectedTheme = themeId;
                updateUI();
                document.documentElement.setAttribute(
                    "data-theme",
                    resolveTheme(themeId),
                );
            }, 150);
            overlayTimeout = setTimeout(() => {
                window.dispatchEvent(new CustomEvent("theme-transition-end"));
            }, 400);
        }

        document.addEventListener("mousedown", (event) => {
            instances.forEach((instance) => {
                if (
                    instance.isOpen() &&
                    !instance.root.contains(event.target)
                ) {
                    instance.close();
                }
            });
        });

        const media = window.matchMedia("(prefers-color-scheme: dark)");
        media.addEventListener("change", () => {
            if (readStoredTheme() === "system") {
                document.documentElement.setAttribute(
                    "data-theme",
                    media.matches ? "warm-dark" : "warm-light",
                );
                updateUI();
            }
        });

        document.documentElement.setAttribute(
            "data-theme",
            resolveTheme(selectedTheme),
        );
        updateUI();
    }
</script>
