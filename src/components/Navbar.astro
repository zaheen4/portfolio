---
import { Icon } from 'astro-icon/components'
import ThemePicker from './ThemePicker.astro'
---

<nav
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b nav-slide-in"
  style="background-color: var(--nav-bg); border-color: var(--bg-border)"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="#hero" class="brand text-2xl font-bold gradient-text">Z</a>

      <div class="hidden md:flex items-center gap-6">
        <div class="nav-links">
          <span class="nav-pill" aria-hidden="true"></span>
          <a href="#about" class="nav-link transition-colors duration-200" data-nav-section="about"
            >About</a
          >
          <a
            href="#skills"
            class="nav-link transition-colors duration-200"
            data-nav-section="skills"
            >Skills</a
          >
          <a
            href="#projects"
            class="nav-link transition-colors duration-200"
            data-nav-section="projects"
            >Projects</a
          >
          <a
            href="#contact"
            class="nav-link transition-colors duration-200"
            data-nav-section="contact"
            >Contact</a
          >
        </div>
        <a
          href={`${import.meta.env.BASE_URL}Mir_Zaheen_Waseet_CV.pdf`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 border border-border rounded-lg text-sm font-medium transition-colors duration-200 inline-flex items-center gap-1.5 hover:border-accent hover:text-accent"
          aria-label="View CV (opens in new tab)"
        >
          <Icon name="lucide:file-text" width="15" height="15" style="color: var(--accent)" />
          <span>CV</span>
        </a>
        <ThemePicker />
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <a
          href={`${import.meta.env.BASE_URL}Mir_Zaheen_Waseet_CV.pdf`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-2.5 py-1 border border-border rounded-lg text-xs font-medium transition-colors duration-200 inline-flex items-center gap-1 hover:border-accent hover:text-accent"
          aria-label="View CV (opens in new tab)"
        >
          <Icon name="lucide:file-text" width="13" height="13" style="color: var(--accent)" />
          <span>CV</span>
        </a>
        <ThemePicker />
        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="mobile-menu-btn"
          style="color: var(--text-primary)"
        >
          <Icon id="menu-icon" name="lucide:menu" width="24" height="24" />
          <Icon id="close-icon" name="lucide:x" width="24" height="24" style="display:none" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden border-t overflow-hidden"
    style="
      max-height: 0;
      transition: max-height 0.3s ease;
      background-color: var(--bg-secondary);
      border-color: var(--bg-border);
    "
  >
    <div class="px-4 py-4 space-y-3">
      <a
        href="#about"
        class="nav-link-mobile block transition-colors duration-200"
        data-nav-section="about"
        >About</a
      >
      <a
        href="#skills"
        class="nav-link-mobile block transition-colors duration-200"
        data-nav-section="skills"
        >Skills</a
      >
      <a
        href="#projects"
        class="nav-link-mobile block transition-colors duration-200"
        data-nav-section="projects"
        >Projects</a
      >
      <a
        href="#contact"
        class="nav-link-mobile block transition-colors duration-200"
        data-nav-section="contact"
        >Contact</a
      >
      <a
        href={`${import.meta.env.BASE_URL}Mir_Zaheen_Waseet_CV.pdf`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 pt-3 mt-1 border-t border-border text-sm font-medium transition-colors duration-200 hover:text-accent"
      >
        <Icon name="lucide:file-text" width="16" height="16" style="color: var(--accent)" />
        <span>View CV (PDF)</span>
      </a>
    </div>
  </div>
</nav>

<script>
  import { animate } from 'animejs'

  ;(function () {
    var btn = document.getElementById('mobile-menu-btn')
    var menu = document.getElementById('mobile-menu')
    var menuIcon = document.getElementById('menu-icon')
    var closeIcon = document.getElementById('close-icon')
    var links = menu ? menu.querySelectorAll('a') : []
    if (!btn || !menu) return
    var isOpen = false

    function closeMenu() {
      isOpen = false
      btn.setAttribute('aria-expanded', 'false')
      menu.style.maxHeight = '0'
      menuIcon.style.display = ''
      closeIcon.style.display = 'none'
    }

    btn.addEventListener('click', function () {
      isOpen = !isOpen
      btn.setAttribute('aria-expanded', String(isOpen))
      menu.style.maxHeight = isOpen ? menu.scrollHeight + 'px' : '0'
      menuIcon.style.display = isOpen ? 'none' : ''
      closeIcon.style.display = isOpen ? '' : 'none'
    })

    links.forEach(function (link) {
      link.addEventListener('click', closeMenu)
    })
  })()

  // Desktop nav: gliding active indicator (scroll-spy)
  ;(function () {
    var pill = document.querySelector('.nav-pill')
    var navLinks = document.querySelector('.nav-links')
    var links = Array.prototype.slice.call(document.querySelectorAll('.nav-link'))
    var mobileLinks = Array.prototype.slice.call(document.querySelectorAll('.nav-link-mobile'))
    var sections = ['hero', 'about', 'skills', 'projects', 'contact']
      .map(function (id) {
        return document.getElementById(id)
      })
      .filter(Boolean)
    if (!pill || !navLinks || !links.length || !sections.length) return

    var current = null
    var PAD = 12 // horizontal breathing room inside the capsule
    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)')
    var glide = null

    function linkFor(id) {
      for (var i = 0; i < links.length; i++) {
        if (links[i].getAttribute('data-nav-section') === id) return links[i]
      }
      return null
    }

    // Snap when appearing or when motion is unwelcome, glide otherwise.
    function place(link) {
      if (glide) {
        glide.cancel()
        glide = null
      }
      if (!link) {
        pill.style.opacity = '0'
        pill.style.width = '0'
        return
      }
      var linkRect = link.getBoundingClientRect()
      var baseRect = navLinks.getBoundingClientRect()
      var left = linkRect.left - baseRect.left - PAD
      var width = linkRect.width + PAD * 2

      if (pill.style.opacity !== '1' || prefersReduced.matches) {
        pill.style.left = left + 'px'
        pill.style.width = width + 'px'
        pill.style.opacity = '1'
        return
      }

      glide = animate(pill, {
        left: left + 'px',
        width: width + 'px',
        opacity: 1,
        duration: 350,
        ease: 'outCubic',
      })
    }

    function setActive(id) {
      if (id === current) return
      current = id
      var active = null
      links.forEach(function (link) {
        var on = link.getAttribute('data-nav-section') === id
        if (on) {
          link.setAttribute('aria-current', 'location')
          active = link
        } else {
          link.removeAttribute('aria-current')
        }
      })
      mobileLinks.forEach(function (link) {
        link.classList.toggle('is-active', link.getAttribute('data-nav-section') === id)
      })
      place(active)
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) setActive(entry.target.id)
        })
      },
      { rootMargin: '-45% 0px -50% 0px' },
    )
    sections.forEach(function (section) {
      observer.observe(section)
    })

    // "Contact" is short and may never cross the middle band; force it at the page end.
    var ticking = false
    window.addEventListener(
      'scroll',
      function () {
        if (ticking) return
        ticking = true
        requestAnimationFrame(function () {
          ticking = false
          var doc = document.documentElement
          if (window.innerHeight + window.scrollY >= doc.scrollHeight - 2) setActive('contact')
        })
      },
      { passive: true },
    )

    links.forEach(function (link) {
      // Move immediately: the scroll animation takes ~600ms.
      link.addEventListener('click', function () {
        setActive(link.getAttribute('data-nav-section'))
      })
      link.addEventListener('pointerenter', function () {
        place(link)
      })
    })

    navLinks.addEventListener('pointerleave', function () {
      place(linkFor(current))
    })

    window.addEventListener('resize', function () {
      place(linkFor(current))
    })

    // Layout can shift without a window resize - a webfont swapping in is
    // the usual culprit, and it changes how wide each label renders.
    // Re-place whenever the track itself changes size.
    new ResizeObserver(function () {
      place(linkFor(current))
    }).observe(navLinks)
  })()
</script>
