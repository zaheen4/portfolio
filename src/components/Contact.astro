---
import { Icon } from 'astro-icon/components'

const contacts = [
  {
    name: 'Email',
    handle: 'zwaseet@gmail.com',
    icon: 'lucide:mail',
    href: 'mailto:zwaseet@gmail.com',
    color: '#ea4335',
    copyable: true,
  },
  {
    name: 'LinkedIn',
    handle: 'mir-zaheen-waseet',
    icon: 'simple-icons:linkedin',
    href: 'https://www.linkedin.com/in/mir-zaheen-waseet',
    color: '#0077b5',
  },
  {
    name: 'Facebook',
    handle: 'zaheen.4',
    icon: 'simple-icons:facebook',
    href: 'https://www.facebook.com/zaheen.4',
    color: '#1877f2',
  },
  {
    name: 'Discord',
    handle: '@zaheen4',
    icon: 'simple-icons:discord',
    href: 'https://discord.com/users/353566198304342016',
    color: '#5865f2',
  },
]
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="py-24 px-4"
  style="background-color: var(--bg-secondary)"
>
  <div class="max-w-4xl mx-auto text-center">
    <div class="section-reveal">
      <h2 id="contact-heading" class="text-3xl sm:text-4xl font-bold mb-1">
        Get In <span class="gradient-text">Touch</span>
      </h2>
      <div class="section-underline mb-4"></div>
      <p class="text-lg max-w-xl mx-auto mb-12" style="color: var(--text-secondary)">
        Have a project in mind or just want to chat? Feel free to reach out through any of these
        channels.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-4" id="contact-cards">
      {contacts.map((contact, i) => {
        const external = contact.href.startsWith('http')
        return <div
          class:list={['contact-chip', contact.copyable && 'has-copy']}
          style={`
                opacity: 0;
                transform: translateY(20px);
                --chip-color: ${contact.color};
                --i: ${i};
              `}
        >
          <a
            href={contact.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="contact-chip-target"
          >
            <Icon
              name={contact.icon}
              width="18"
              height="18"
              style={`color: ${contact.color}; flex-shrink: 0;`}
              aria-hidden="true"
            />
            <div class="text-left">
              <div class="text-sm font-medium">{contact.name}</div>
              <div class="contact-handle">{contact.handle}</div>
            </div>
            {external && <span class="sr-only">(opens in new tab)</span>}
          </a>
          {contact.copyable && <button
            type="button"
            class="contact-copy"
            data-copy={contact.handle}
            aria-label={`Copy ${contact.name.toLowerCase()} address`}
          >
            <Icon name="lucide:copy" width="15" height="15" aria-hidden="true" />
          </button>}
        </div>
      })}
    </div>

    <div class="copy-toast" id="copy-toast" role="status"></div>
  </div>
</section>

<style>
  .contact-chip {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    border-radius: 999px;
    border: 1px solid var(--bg-border);
    background: color-mix(in srgb, var(--bg-card) 65%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color 0.25s ease;
  }

  /* The link fills the pill so the whole chip stays clickable, and the copy
     button sits beside it rather than inside it - a button cannot legally
     nest in an anchor. */
  .contact-chip-target {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .contact-chip.has-copy .contact-chip-target {
    padding-right: 0.6rem;
  }

  .contact-copy {
    display: inline-flex;
    align-items: center;
    padding: 0 0.85rem 0 0.6rem;
    border: 0;
    border-left: 1px solid var(--bg-border);
    border-radius: 0 999px 999px 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.25s ease,
      background-color 0.25s ease;
  }

  .contact-copy:hover {
    color: var(--chip-color);
    background: color-mix(in srgb, var(--chip-color) 12%, transparent);
  }

  .copy-toast {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 5.5rem; /* clears the back-to-top button and the footer line */
    /* Inline-axis centring rather than a translate, so transform stays free
       for the show/hide animation. */
    margin-inline: auto;
    width: fit-content;
    max-width: min(92vw, 24rem);
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--bg-border);
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 500;
    box-shadow: 0 8px 24px var(--glow-shadow);
    opacity: 0;
    pointer-events: none;
    z-index: 60;
  }

  .contact-chip::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 10%;
    width: 80%;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--chip-color) 40%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .contact-chip:hover::before {
    opacity: 1;
  }

  .contact-chip:hover {
    transform: translateY(-2px);
    border-color: var(--chip-color);
  }

  .contact-chip:hover .contact-handle {
    color: color-mix(in srgb, var(--chip-color) 80%, var(--text-primary));
  }

  .contact-handle {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.1;
    transition: color 0.25s ease;
  }
</style>

<script>
  import { animate, stagger } from 'animejs'

  var container = document.getElementById('contact-cards')
  if (container && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var chips = entry.target.querySelectorAll('.contact-chip')
            if (chips.length) {
              animate(chips, {
                opacity: [0, 1],
                translateY: [20, 0],
                delay: stagger(100),
                ease: 'outBack',
                duration: 600,
                onComplete: function () {
                  chips.forEach(function (chip) {
                    chip.style.transform = ''
                  })
                },
              })
            }
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.2 },
    )
    observer.observe(container)
  }

  var toast = document.getElementById('copy-toast')
  var toastTimer = null
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)')

  function showToast(message) {
    if (!toast) return
    clearTimeout(toastTimer)
    toast.textContent = message

    if (prefersReduced.matches) {
      toast.style.opacity = '1'
      toast.style.transform = ''
    } else {
      // Reset to the off state first, so a repeat click replays the fade
      // instead of flashing.
      toast.style.opacity = '0'
      toast.style.transform = 'translateY(12px)'
      animate(toast, { opacity: 1, translateY: 0, duration: 250, ease: 'outCubic' })
    }

    toastTimer = setTimeout(hideToast, 2200)
  }

  function hideToast() {
    if (!toast) return
    if (prefersReduced.matches) {
      toast.style.opacity = '0'
      toast.style.transform = ''
      return
    }
    animate(toast, {
      opacity: 0,
      translateY: 12,
      duration: 250,
      ease: 'inCubic',
      onComplete: function () {
        toast.style.transform = ''
      },
    })
  }

  function copyText(value) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(value)
    }
    // Fallback for anything without the async clipboard API.
    return new Promise(function (resolve, reject) {
      try {
        var field = document.createElement('textarea')
        field.value = value
        field.setAttribute('readonly', '')
        field.style.position = 'fixed'
        field.style.top = '-1000px'
        document.body.appendChild(field)
        field.select()
        var copied = document.execCommand('copy')
        document.body.removeChild(field)
        if (copied) resolve()
        else reject(new Error('copy blocked'))
      } catch (error) {
        reject(error)
      }
    })
  }

  document.querySelectorAll('.contact-copy').forEach(function (button) {
    button.addEventListener('click', function () {
      copyText(button.getAttribute('data-copy')).then(
        function () {
          showToast('Email copied to clipboard')
        },
        function () {
          showToast('Could not copy — select it manually')
        },
      )
    })
  })
</script>
